[Rule]
# Surge owns production routing rules. Tower only supplies concrete proxies.
# External RULE-SET resources are cached and refreshed by Surge.

RULE-SET,SYSTEM,DIRECT
RULE-SET,LAN,DIRECT,no-resolve

# Family-specific high-priority routing.
RULE-SET,https://raw.githubusercontent.com/north-coding/Surge-Rules/main/rules/AI.list,AI,extended-matching,update-interval=86400
RULE-SET,https://raw.githubusercontent.com/north-coding/Surge-Rules/main/rules/Netflix.list,Netflix,extended-matching,update-interval=86400

# ACL4SSR direct / ad decisions.
RULE-SET,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/UnBan.list,DIRECT,update-interval=86400
RULE-SET,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/BanAD.list,REJECT,update-interval=86400
RULE-SET,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/BanProgramAD.list,REJECT,update-interval=86400
RULE-SET,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/GoogleCN.list,DIRECT,update-interval=86400
RULE-SET,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/Ruleset/SteamCN.list,DIRECT,update-interval=86400

RULE-SET,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/Microsoft.list,Microsoft,extended-matching,update-interval=86400
RULE-SET,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/Apple.list,Apple,extended-matching,update-interval=86400

RULE-SET,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/ProxyLite.list,Node Select,extended-matching,update-interval=86400
RULE-SET,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/ChinaDomain.list,DIRECT,update-interval=86400
RULE-SET,https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/ChinaCompanyIp.list,DIRECT,update-interval=86400
GEOIP,CN,DIRECT

FINAL,Node Select,dns-failed
