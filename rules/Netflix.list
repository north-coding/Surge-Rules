# Netflix-specific AWS service host patterns. Narrow keywords are used here
# instead of broad amazonaws.com matching.
DOMAIN-KEYWORD,apiproxy-device-prod-nlb-
DOMAIN-KEYWORD,apiproxy-website-nlb-prod-
DOMAIN-KEYWORD,dualstack.apiproxy-
DOMAIN-KEYWORD,dualstack.ichnaea-web-
DOMAIN,netflix.com.edgesuite.net
